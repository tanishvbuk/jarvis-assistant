# Copy this file to .env and fill in the keys you have.
# .env is gitignored; never commit real keys.

# Groq (free tier, for testing with dummy data only): https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic (Claude): https://console.anthropic.com/
# Set a monthly spend limit in the console before adding credit.
ANTHROPIC_API_KEY=

# Tavily (web search for Jarvis; free plan, no card): https://app.tavily.com/
TAVILY_API_KEY=

# OpenRouter (optional): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Time zone for dates and reminders (IANA name), e.g. America/New_York. Defaults to UTC.
JARVIS_TZ=
